# Do not commit actual credentials or tokens. Configure these securely in CI variables.
TARGET_ENV=uat
BASE_URL=https://uat-remora.redikru.com
API_EMAIL=replace-with-test-account-email
API_PASSWORD=replace-with-test-account-password
# Target company to select in the admin flow
TARGET_COMPANY_ID=replace-with-company-uuid
TARGET_COMPANY_NAME=PT QA TEST Full ,Tbk
# Optional. Only set this if the API requires this header after company selection.
COMPANY_ID_HEADER=x-company-id
# Required for Master Planning EXPIRING classification. Use the existing
# business threshold; the suite deliberately has no guessed default.
EXPIRING_THRESHOLD_DAYS=30
# Opt in only when using an isolated, disposable UAT planning fixture. This
# scenario adds a nominee, proceeds it, then reverts it during cleanup.
ENABLE_STATEFUL_PLANNING_TESTS=false
# Runtime controls. Keep the suite serial while the account context is shared.
API_TIMEOUT_MS=30000
SCENARIO_TIMEOUT_MS=180000
SELECTION_PAGE_LIMIT=100
FILTER_REFERENCE_LIMIT=250
TIMELINE_CANDIDATE_LIMIT=10
DIAGNOSTIC_BODY_LIMIT=12000
# Production is blocked by default. It requires ALLOW_PRODUCTION_TESTS=true and
# never enables CAPTCHA bypass by default.
# ALLOW_PRODUCTION_TESTS=false
